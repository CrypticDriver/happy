{
  "name": "happy-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Happy desktop client: webapp shell + local machine daemon with exec approval",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.2",
    "@types/node": "^22.10.0"
  },
  "build": {
    "appId": "com.goudan.happy-desktop",
    "productName": "Happy",
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
